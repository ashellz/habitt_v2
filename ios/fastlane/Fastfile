# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

# App Store limits, in characters (not bytes).
ASO_LIMITS = { "name" => 30, "subtitle" => 30, "keywords" => 100, "promotional_text" => 170, "description" => 4000 }.freeze

# Fails the lane on any over-limit or malformed metadata, so a bad edit never
# reaches App Store Connect half-applied. Also warns about wasted keywords.
def check_ios_metadata!
  errors = []
  Dir.glob("metadata/*/").sort.each do |dir|
    locale = File.basename(dir)
    ASO_LIMITS.each do |file, max|
      path = File.join(dir, "#{file}.txt")
      next unless File.exist?(path)
      text = File.read(path, encoding: "UTF-8").strip
      errors << "#{locale}/#{file}: #{text.length}/#{max} chars" if text.length > max
    end

    kw_path = File.join(dir, "keywords.txt")
    next unless File.exist?(kw_path)
    keywords = File.read(kw_path, encoding: "UTF-8").strip
    errors << "#{locale}/keywords: has a space after a comma (wastes a character)" if keywords.include?(", ")

    # Apple indexes name + subtitle + keywords together, so repeating a word is waste.
    seen = %w[name subtitle].flat_map do |f|
      p = File.join(dir, "#{f}.txt")
      File.exist?(p) ? File.read(p, encoding: "UTF-8").downcase.scan(/[[:alpha:]]+/) : []
    end
    dupes = keywords.downcase.split(",").select { |k| seen.include?(k) }
    UI.important("#{locale}: keywords repeat name/subtitle words: #{dupes.join(', ')}") unless dupes.empty?
  end
  UI.user_error!("Metadata over limit:\n  #{errors.join("\n  ")}") unless errors.empty?
  UI.success("iOS metadata within App Store limits")
end

platform :ios do
  desc "Check name/subtitle/keywords/description lengths for every locale (offline)"
  lane :check_metadata do
    check_ios_metadata!
  end

  desc "Validate, then upload store text only (name, subtitle, keywords, description). No binary, no screenshots, no review submission"
  lane :metadata do
    check_ios_metadata!
    deliver(
      api_key_path: File.expand_path("~/.appstoreconnect/private_keys/api_key.json"),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload the built IPA to TestFlight with per-locale What's New from release_notes.txt"
  lane :internal do
    whats_new = {}
    Dir.glob("metadata/*/release_notes.txt").each do |path|
      text = File.read(path).strip
      whats_new[File.basename(File.dirname(path))] = { whats_new: text } unless text.empty?
    end

    upload_to_testflight(
      api_key_path: File.expand_path("~/.appstoreconnect/private_keys/api_key.json"),
      ipa: Dir.glob(File.expand_path("../../build/ios/ipa/*.ipa", __dir__)).first || UI.user_error!("No IPA in build/ios/ipa, run flutter build ipa first"),
      localized_build_info: whats_new,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Submit the already-uploaded TestFlight build to App Store review (release notes only)"
  lane :submit do |options|
    deliver(
      api_key_path: File.expand_path("~/.appstoreconnect/private_keys/api_key.json"),
      app_version: options[:version],
      build_number: options[:build],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  # Store language of the watch screenshots (marketing/watch_screenshots/watchos/<lang>)
  # → the App Store locales that get them. Other locales fall back to en-US.
  WATCH_LOCALES = {
    "en" => %w[en-US en-AU en-CA en-GB], "de" => %w[de-DE], "es" => %w[es-ES es-MX],
    "fr" => %w[fr-FR fr-CA], "it" => %w[it], "pt" => %w[pt-BR pt-PT], "tr" => %w[tr], "bs" => %w[hr]
  }.freeze

  desc "Stage the watch screenshots (all languages) and the en-US iPhone watch slide, then upload them and the store text to the given version (created if needed). Adds screenshots, never deletes. No review submission"
  lane :watch_screenshots do |options|
    version = options[:version] || UI.user_error!("pass version:<x.y.z>")
    check_ios_metadata!
    src = File.expand_path("../../marketing/watch_screenshots", __dir__)
    stage = File.expand_path("../../build/store_screenshots/ios", __dir__)
    FileUtils.rm_rf(stage)
    WATCH_LOCALES.each do |lang, locales|
      locales.each do |locale|
        FileUtils.mkdir_p(File.join(stage, locale))
        Dir.glob(File.join(src, "watchos", lang, "*.png")).sort.each do |png|
          FileUtils.cp(png, File.join(stage, locale, "watch_#{File.basename(png)}"))
        end
      end
    end
    FileUtils.cp(File.join(src, "phone_slides", "apple_watch_iphone_1206x2622.png"), File.join(stage, "en-US", "iphone_9_watch.png"))
    deliver(
      api_key_path: File.expand_path("~/.appstoreconnect/private_keys/api_key.json"),
      app_version: version,
      screenshots_path: stage,
      overwrite_screenshots: false,
      skip_binary_upload: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Push a new release build to the App Store"
  lane :release do
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner")
    upload_to_app_store
  end
end
