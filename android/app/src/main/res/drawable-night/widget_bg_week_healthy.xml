<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widgets (docs/home_widgets.md). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp"/>
            <solid android:color="#181818"/>
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="top|right" android:right="-70dp" android:top="-70dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="84dp" android:startColor="#57F47200" android:endColor="#00F47200"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#2F3030"/>
        </shape>
    </item>
</layer-list>
