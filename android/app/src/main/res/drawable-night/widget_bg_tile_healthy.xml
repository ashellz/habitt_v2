<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widgets (docs/home_widgets.md). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="18dp"/>
            <gradient android:angle="225" android:startColor="#FFE07A" android:endColor="#F47200"/>
        </shape>
    </item>
    <item android:width="130dp" android:height="130dp" android:gravity="bottom|right" android:right="-46dp" android:bottom="-46dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="62dp" android:startColor="#E6F47200" android:endColor="#00F47200"/>
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_streak" android:width="64dp" android:height="64dp" android:gravity="bottom|right" android:right="-6dp" android:bottom="-8dp"/>
</layer-list>
