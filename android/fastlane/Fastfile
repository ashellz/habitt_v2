# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

# Google Play limits, in characters (not bytes).
PLAY_LIMITS = { "title" => 30, "short_description" => 80, "full_description" => 4000 }.freeze

# Fails the lane on any over-limit text so Play never gets a half-applied listing.
def check_play_metadata!
  errors = []
  Dir.glob("metadata/android/*/").sort.each do |dir|
    locale = File.basename(dir)
    PLAY_LIMITS.each do |file, max|
      path = File.join(dir, "#{file}.txt")
      next unless File.exist?(path)
      text = File.read(path, encoding: "UTF-8").strip
      errors << "#{locale}/#{file}: #{text.length}/#{max} chars" if text.length > max
    end
  end
  UI.user_error!("Metadata over limit:\n  #{errors.join("\n  ")}") unless errors.empty?
  UI.success("Play metadata within limits")
end

platform :android do
  desc "Check title/short/full description lengths for every locale (offline)"
  lane :check_metadata do
    check_play_metadata!
  end

  desc "Validate, then upload the store listing text only (title, short and full description) for all locales"
  lane :metadata do
    check_play_metadata!
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # Language of the watch screenshots (marketing/watch_screenshots/wear_os/<lang>)
  # → the Play locales that get them. Other locales fall back to en-US.
  WEAR_LOCALES = {
    "en" => %w[en-US en-GB en-AU en-CA], "de" => %w[de-DE], "es" => %w[es-ES es-419],
    "fr" => %w[fr-FR fr-CA], "it" => %w[it-IT], "pt" => %w[pt-BR pt-PT], "tr" => %w[tr-TR], "bs" => %w[hr]
  }.freeze
  PLAY_STAGE = File.expand_path("../../build/store_screenshots/android", __dir__)

  desc "Upload the Wear OS screenshots (all languages) to the Play listing. Touches only wearScreenshots"
  lane :wear_screenshots do
    src = File.expand_path("../../marketing/watch_screenshots/wear_os", __dir__)
    FileUtils.rm_rf(PLAY_STAGE)
    WEAR_LOCALES.each do |lang, locales|
      locales.each do |locale|
        dir = File.join(PLAY_STAGE, locale, "images", "wearScreenshots")
        FileUtils.mkdir_p(dir)
        Dir.glob(File.join(src, lang, "*.png")).sort.each { |png| FileUtils.cp(png, dir) }
      end
    end
    upload_to_play_store(
      metadata_path: PLAY_STAGE,
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true,
      sync_image_upload: true
    )
  end

  desc "When the watch apps are on Play production: upload the listing text (widgets + Wear OS) and add the Wear OS phone slide. A locale with a full set (8) gets it in place of the last one (Themes), others get it appended. Keeps every other phone screenshot"
  lane :watch_listing do
    check_play_metadata!
    require "open-uri"
    slide = File.expand_path("../../marketing/watch_screenshots/phone_slides/wear_os_phone_1206x2622.png", __dir__)
    slide_sha = Digest::SHA256.file(slide).hexdigest
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                       { json_key: File.expand_path("key.json", __dir__), package_name: "com.shellz.habitt" })
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: "com.shellz.habitt")
    FileUtils.rm_rf(PLAY_STAGE)
    client.listings.each do |listing|
      images = client.fetch_images(image_type: "phoneScreenshots", language: listing.language)
      next if images.empty? || images.any? { |i| i.sha256 == slide_sha }
      dir = File.join(PLAY_STAGE, listing.language, "images", "phoneScreenshots")
      FileUtils.mkdir_p(dir)
      keep = images.size >= 8 ? images.first(7) : images
      keep.each_with_index { |img, i| File.binwrite(File.join(dir, format("%02d.png", i + 1)), URI.open(img.url).read) }
      FileUtils.cp(slide, File.join(dir, format("%02d.png", keep.size + 1)))
      UI.message("#{listing.language}: #{images.size} phone screenshots → #{keep.size + 1}")
    end
    client.abort_current_edit
    # text from the repo, phone screenshots from the stage (keeping the rest unchanged)
    Dir.glob("metadata/android/*/").each do |dir|
      locale = File.basename(dir)
      FileUtils.mkdir_p(File.join(PLAY_STAGE, locale))
      %w[title.txt short_description.txt full_description.txt video.txt].each do |f|
        FileUtils.cp(File.join(dir, f), File.join(PLAY_STAGE, locale)) if File.exist?(File.join(dir, f))
      end
    end
    upload_to_play_store(
      metadata_path: PLAY_STAGE,
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_changelogs: true,
      skip_upload_images: true, sync_image_upload: true
    )
  end

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Upload the built AAB to the Play internal testing track with per-locale changelogs"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the internal track build to production"
  lane :promote do |options|
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: (options[:version_code] || UI.user_error!("pass version_code:<n>")).to_i,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end
end
